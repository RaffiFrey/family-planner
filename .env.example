# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development

# Database: migrations run as the owner, the API uses the RLS-restricted fp_app role
# and fp_system (BYPASSRLS) for auth, workers and admin.
DATABASE_MIGRATION_URL=postgres://fp:fp@localhost:5432/family_planer
DATABASE_URL=postgres://fp_app:fp_app@localhost:5432/family_planer
DATABASE_SYSTEM_URL=postgres://fp_system:fp_system@localhost:5432/family_planer
DB_APP_PASSWORD=fp_app
DB_SYSTEM_PASSWORD=fp_system

REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# 32 bytes, base64. Used for field-level encryption (IBANs etc.).
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Object storage (SeaweedFS locally, Scaleway/Hetzner in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-central-1
S3_BUCKET=family-planer-files
S3_ACCESS_KEY_ID=fp-s3
S3_SECRET_ACCESS_KEY=fp-s3-secret
S3_FORCE_PATH_STYLE=true
CLAMAV_HOST=
CLAMAV_PORT=3310

# Email (Mailpit locally: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Family Planer <no-reply@family-planer.local>"

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTH=
STRIPE_PRICE_PLUS_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
REVENUECAT_WEBHOOK_SECRET=

# Push
EXPO_ACCESS_TOKEN=

# Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Admin bootstrap (creates the first superadmin if no staff exists)
ADMIN_BOOTSTRAP_EMAIL=admin@family-planer.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password

# AI assistant (Claude)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# Bank sync (PSD2 via licensed aggregator): none | mock | finapi
BANK_SYNC_PROVIDER=mock
FINAPI_BASE_URL=https://sandbox.finapi.io
FINAPI_CLIENT_ID=
FINAPI_CLIENT_SECRET=

# Google Calendar two-way sync
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# OCR (document vault)
OCR_ENABLED=true
OCR_LANGS=deu+eng
