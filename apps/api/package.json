{
  "name": "@fp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "openapi": "node --env-file-if-exists=../../.env dist/openapi.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@better-auth/expo": "1.7.13",
    "@better-auth/passkey": "1.7.13",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fp/contracts": "workspace:*",
    "@fp/db": "workspace:*",
    "@fp/domain": "workspace:*",
    "@fp/i18n": "workspace:*",
    "@napi-rs/canvas": "^1.0.13",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "^11.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "archiver": "^8.0.0",
    "better-auth": "1.7.13",
    "bullmq": "^6.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ical.js": "^2.2.1",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.1",
    "tesseract.js": "^7.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fp/config": "workspace:*",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
